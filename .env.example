# QueueLab: variables de entorno de ejemplo.
# Copie este fichero a `.env` (ignorado por Git) y ajuste los valores.
#   cp .env.example .env
# Los valores de abajo son SOLO para desarrollo local: no son secretos reales.
# Docker Compose lee `.env` automáticamente. Para la API y el worker, cárguelo
# en su shell (`set -a; source .env; set +a`) o use el perfil `local` de Spring.

# ---------------------------------------------------------------------------
# Docker Compose: servicios locales (docker-compose.yml)
# ---------------------------------------------------------------------------
# PostgreSQL
POSTGRES_DB=queuelab
POSTGRES_USER=queuelab
POSTGRES_PASSWORD=queuelab
# Puerto del host (127.0.0.1). 5434 evita chocar con instancias locales en 5432/5433.
POSTGRES_PORT=5434

# RabbitMQ
RABBITMQ_USER=queuelab
RABBITMQ_PASSWORD=queuelab
# Puerto AMQP y consola de administración (http://localhost:15672) en el host.
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

# Redis (contadores del límite de envíos). Puerto del host (127.0.0.1).
REDIS_PORT=6379

# Stack completo en contenedores (API, worker y dashboard; ver docs/compose-stack.md). Puertos del host (127.0.0.1).
# El dashboard llama a la API desde el navegador: si cambia API_PORT, el dashboard y el CORS se ajustan solos.
# API_PORT=8080
# DASHBOARD_PORT=3000

# Observabilidad (perfil `observability`: docker compose --profile observability up -d). Puertos en 127.0.0.1.
# Grafana usa el 3300 para no chocar con el dashboard web (3000). Ver docs/observability/dashboard.md.
# PROMETHEUS_PORT=9090
# Con el stack completo en contenedores, apunta Prometheus a los servicios de la red de Compose:
# PROMETHEUS_CONFIG=./observability/prometheus/prometheus.compose.yml
# GRAFANA_PORT=3300
# GRAFANA_USER=admin
# GRAFANA_PASSWORD=admin

# ---------------------------------------------------------------------------
# API y worker (Spring Boot): conexión a servicios
# ---------------------------------------------------------------------------
# Deben coincidir con los valores de Docker Compose de arriba.
# Perfil de Spring: `local` aplica credenciales de desarrollo si no se definen
# las contraseñas. En cualquier otro entorno defina las contraseñas explícitamente.
SPRING_PROFILES_ACTIVE=local

QUEUELAB_DB_URL=jdbc:postgresql://localhost:5434/queuelab
QUEUELAB_DB_USER=queuelab
QUEUELAB_DB_PASSWORD=queuelab

QUEUELAB_RABBITMQ_HOST=localhost
QUEUELAB_RABBITMQ_PORT=5672
QUEUELAB_RABBITMQ_USER=queuelab
QUEUELAB_RABBITMQ_PASSWORD=queuelab

# Solo la API: Redis, donde se cuentan los envíos por cliente (compartido entre instancias de la API).
QUEUELAB_REDIS_HOST=localhost
QUEUELAB_REDIS_PORT=6379
# QUEUELAB_REDIS_PASSWORD=

# Orígenes del dashboard que pueden llamar a la API desde el navegador (CORS), separados por comas.
# Por defecto solo http://localhost:3000; vacío desactiva CORS.
# QUEUELAB_CORS_ALLOWED_ORIGINS=http://localhost:3000

# Solo la API: contrapresión. Con tantos trabajos esperando worker (QUEUED o RETRYING) los envíos nuevos
# reciben 503 con Retry-After. Ver backend/README.md, «Contrapresión».
# QUEUELAB_BACKPRESSURE_MAX_PENDING=1000
# QUEUELAB_BACKPRESSURE_RETRY_AFTER=30s

# Solo la API: límite de envíos. Cada cliente (IP) puede hacer MAX_REQUESTS envíos (POST /jobs y /jobs/csv) por
# ventana; el exceso recibe 429 con Retry-After. Ver backend/README.md, «Límite de envíos».
# QUEUELAB_RATE_LIMIT_ENABLED=true
# QUEUELAB_RATE_LIMIT_MAX_REQUESTS=60
# QUEUELAB_RATE_LIMIT_WINDOW=1m

# Solo el worker: trabajos que ejecuta a la vez cada proceso (1-64, por defecto 2) y mensajes
# sin confirmar por consumidor (por defecto 1). Ver backend/README.md, «Concurrencia del worker».
# QUEUELAB_WORKER_CONCURRENCY=2
# QUEUELAB_WORKER_PREFETCH=1

# ---------------------------------------------------------------------------
# Dashboard (Next.js)
# ---------------------------------------------------------------------------
# Next.js solo lee `frontend/.env*`; la variable equivalente está en
# frontend/.env.example. Se lista aquí como referencia.
# NEXT_PUBLIC_API_URL=http://localhost:8080
