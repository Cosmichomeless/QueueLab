# QueueLab: variables de entorno de ejemplo.
# Copie este fichero a `.env` (ignorado por Git) y ajuste los valores.
#   cp .env.example .env
# Los valores de abajo son SOLO para desarrollo local: no son secretos reales.
# Docker Compose lee `.env` automáticamente. Para la API y el worker, cárguelo
# en su shell (`set -a; source .env; set +a`) o use el perfil `local` de Spring.

# ---------------------------------------------------------------------------
# Docker Compose: servicios locales (docker-compose.yml)
# ---------------------------------------------------------------------------
# PostgreSQL
POSTGRES_DB=queuelab
POSTGRES_USER=queuelab
POSTGRES_PASSWORD=queuelab
# Puerto del host (127.0.0.1). 5434 evita chocar con instancias locales en 5432/5433.
POSTGRES_PORT=5434

# RabbitMQ
RABBITMQ_USER=queuelab
RABBITMQ_PASSWORD=queuelab
# Puerto AMQP y consola de administración (http://localhost:15672) en el host.
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

# ---------------------------------------------------------------------------
# API y worker (Spring Boot): conexión a servicios
# ---------------------------------------------------------------------------
# Deben coincidir con los valores de Docker Compose de arriba.
# Perfil de Spring: `local` aplica credenciales de desarrollo si no se definen
# las contraseñas. En cualquier otro entorno defina las contraseñas explícitamente.
SPRING_PROFILES_ACTIVE=local

QUEUELAB_DB_URL=jdbc:postgresql://localhost:5434/queuelab
QUEUELAB_DB_USER=queuelab
QUEUELAB_DB_PASSWORD=queuelab

QUEUELAB_RABBITMQ_HOST=localhost
QUEUELAB_RABBITMQ_PORT=5672
QUEUELAB_RABBITMQ_USER=queuelab
QUEUELAB_RABBITMQ_PASSWORD=queuelab

# Orígenes del dashboard que pueden llamar a la API desde el navegador (CORS), separados por comas.
# Por defecto solo http://localhost:3000; vacío desactiva CORS.
# QUEUELAB_CORS_ALLOWED_ORIGINS=http://localhost:3000

# ---------------------------------------------------------------------------
# Dashboard (Next.js)
# ---------------------------------------------------------------------------
# Next.js solo lee `frontend/.env*`; la variable equivalente está en
# frontend/.env.example. Se lista aquí como referencia.
# NEXT_PUBLIC_API_URL=http://localhost:8080
