# QueueLab: variables de la configuración pública (docker-compose.prod.yml). Ver docs/deployment/secrets-tls-access.md.
#   cp .env.production.example .env.production      # .env.production NO se versiona (está en .gitignore)
# Todos los secretos están VACÍOS a propósito: Compose se niega a arrancar mientras falten. Genérelos, no los invente:
#   openssl rand -base64 24                          # contraseñas de PostgreSQL, RabbitMQ y Grafana
#   docker run --rm caddy:2-alpine caddy hash-password --plaintext 'su-contraseña'   # hash bcrypt para Caddy

# Contraseñas de los servicios de datos (usuarios: POSTGRES_USER / RABBITMQ_USER, por defecto `queuelab`).
POSTGRES_PASSWORD=
RABBITMQ_PASSWORD=
# Solo con el perfil `observability`.
GRAFANA_PASSWORD=

# Acceso: usuario y HASH BCRYPT (no la contraseña en claro). El hash contiene `$`: déjelo entre comillas simples.
QUEUELAB_BASIC_AUTH_USER=
QUEUELAB_BASIC_AUTH_HASH=''

# Dirección pública, con esquema y puerto si no es el 443. Debe coincidir con QUEUELAB_DOMAIN y QUEUELAB_HTTPS_PORT.
#   prueba local:  QUEUELAB_DOMAIN=localhost  y  QUEUELAB_PUBLIC_URL=https://localhost:8443
#   con dominio:   QUEUELAB_DOMAIN=queuelab.ejemplo.org  y  QUEUELAB_PUBLIC_URL=https://queuelab.ejemplo.org
QUEUELAB_DOMAIN=localhost
QUEUELAB_PUBLIC_URL=https://localhost:8443
QUEUELAB_HTTPS_PORT=8443
QUEUELAB_HTTP_PORT=8080

# Interfaz en la que escucha Caddy. 127.0.0.1 = solo esta máquina (por defecto). 0.0.0.0 = abierto a la red:
# decídalo solo después de leer la política de acceso del documento.
QUEUELAB_BIND=127.0.0.1
