# Dashboard de QueueLab: variables de entorno de ejemplo.
# Copie este fichero a `.env.local` (ignorado por Git):
#   cp .env.example .env.local
# Las variables NEXT_PUBLIC_* se incluyen en el bundle del navegador: no ponga secretos aquí.

# URL base de la API de QueueLab.
NEXT_PUBLIC_API_URL=http://localhost:8080
