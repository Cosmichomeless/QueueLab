# Dashboard de QueueLab: variables de entorno de ejemplo.
# Copie este fichero a `.env.local` (ignorado por Git):
#   cp .env.example .env.local
# La URL de la API llega al navegador: no ponga secretos aquí.

# URL base de la API de QueueLab, tal como la ve el navegador. Se lee al arrancar (no al compilar), así que en un
# contenedor basta con `-e QUEUELAB_API_URL=...`. Si falta, se usa NEXT_PUBLIC_API_URL y, si no, http://localhost:8080.
QUEUELAB_API_URL=http://localhost:8080
